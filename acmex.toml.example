# AcmeX v0.9.0 example configuration
#
# Management API keys are intentionally supplied by environment only:
#
#   ACMEX_API_KEYS=comma,separated,keys
#
# This example parses and validates without real DNS provider credentials.

[acme]
ca = "letsencrypt"
ca_environment = "staging"
contact = ["mailto:admin@example.com"]
tos_agreed = true

[storage]
backend = "file"

[storage.file]
path = ".acmex/certs"

[repository]
backend = "file"
namespace = "default"

[repository.file]
path = ".acmex/repository"

[repository.migration]
mode = "off"

[challenge]
challenge_type = "dns-01"

[challenge.http01]
listen_addr = "127.0.0.1:5002"
challenge_path = ".well-known/acme-challenge"

[challenge.dns01]
propagation_timeout_secs = 300

[challenge.tls_alpn]
listen_addr = "127.0.0.1:5001"

[renewal]
check_interval = 3600
renew_before_days = 30
max_retries = 3
retry_delay_secs = 300
concurrency = 5

[metrics]
enabled = true
listen_addr = "127.0.0.1:9090"
prefix = "acmex"

[cli]
output_format = "text"
colors = true
log_level = "info"
log_max_size = 100
log_backup_count = 10

[server]
listen_addr = "127.0.0.1:8080"
enable_api = true
enable_webhook = true
