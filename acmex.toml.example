# AcmeX v0.9.0 example configuration
#
# Management API keys are intentionally supplied by environment only:
#
#   ACMEX_API_KEYS=comma,separated,keys
#
# This example parses and validates without real DNS provider credentials.

[acme]
ca = "letsencrypt"
ca_environment = "staging"
contact = ["mailto:admin@example.com"]
tos_agreed = true
# Certificate trust-anchor verification is strict by default. Add Pebble,
# private-CA, or staging roots here before driving issuance against those CAs.
trust_anchor_pem_files = []
# Controlled test/bootstrap escape hatch only; when false, empty anchors fail
# `chain_trusted` instead of accepting an unverifiable chain.
skip_certificate_trust_check = false

# External Account Binding for CAs that require it. The HMAC key is always a
# SecretRef (env:/file:/vault:/provider:), never a literal secret value.
# [ca.eab]
# key_id = "ca-issued-key-id"
# hmac_key = "env:ACMEX_EAB_HMAC"

[storage]
backend = "file"

[storage.file]
path = ".acmex/certs"

[repository]
backend = "file"
namespace = "default"

[repository.file]
path = ".acmex/repository"

[repository.migration]
mode = "off"

[challenge]
challenge_type = "dns-01"

[challenge.http01]
listen_addr = "127.0.0.1:5002"
challenge_path = ".well-known/acme-challenge"

[challenge.dns01]
# Overall DNS propagation deadline in seconds.
propagation_timeout_secs = 300

[challenge.tls_alpn]
listen_addr = "127.0.0.1:5001"

# DNS propagation observation policy: AcmeX waits until the TXT record is
# visible on the authoritative nameservers and, when configured, recursive
# resolvers before acknowledging the challenge.
[dns.propagation]
# Quorum over authoritative nameservers: "all" or a positive integer.
authoritative_quorum = "all"
# Empty list explicitly skips recursive confirmation; add "ip:port" resolvers
# such as "1.1.1.1:53" to require recursive quorum.
recursive_resolvers = []
# Quorum over recursive resolvers: "all" or a positive integer.
recursive_quorum = 1
# Overall wait budget, poll interval, and per-query timeout in seconds.
max_wait_secs = 300
poll_interval_secs = 5
query_timeout_secs = 5

[renewal]
check_interval = 3600
renew_before_days = 30
max_retries = 3
retry_delay_secs = 300
concurrency = 5

[metrics]
enabled = true
listen_addr = "127.0.0.1:9090"
prefix = "acmex"

[cli]
output_format = "text"
colors = true
log_level = "info"
log_max_size = 100
log_backup_count = 10

[server]
listen_addr = "127.0.0.1:8080"
enable_api = true
enable_webhook = true
