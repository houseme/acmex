# AcmeX v0.9.0 example configuration
#
# Management API keys are intentionally supplied by environment only:
#
#   ACMEX_API_KEYS=comma,separated,keys
#
# This example parses and validates without real DNS provider credentials.

[acme]
ca = "letsencrypt"
ca_environment = "staging"
contact = ["mailto:admin@example.com"]
tos_agreed = true

# External Account Binding for CAs that require it. The HMAC key is always a
# SecretRef (env:/file:/vault:/provider:), never a literal secret value.
# [ca.eab]
# key_id = "ca-issued-key-id"
# hmac_key = "env:ACMEX_EAB_HMAC"

[storage]
backend = "file"

[storage.file]
path = ".acmex/certs"

[repository]
backend = "file"
namespace = "default"

[repository.file]
path = ".acmex/repository"

[repository.migration]
mode = "off"

[challenge]
challenge_type = "dns-01"

[challenge.http01]
listen_addr = "127.0.0.1:5002"
challenge_path = ".well-known/acme-challenge"

[challenge.dns01]
# Overall DNS propagation deadline in seconds.
propagation_timeout_secs = 300

# DNS propagation observation policy: AcmeX waits until the TXT record is
# visible on the authoritative nameservers and the configured recursive
# resolvers (per the quorums below) before acknowledging the challenge.
[challenge.dns01.propagation]
# Quorum over authoritative nameservers: "all" or a positive integer.
authoritative_quorum = "all"
# Recursive resolvers queried after the authoritative nameservers,
# as "ip:port" (a bare IP defaults to port 53).
recursive_resolvers = ["1.1.1.1:53", "8.8.8.8:53"]
# Quorum over recursive resolvers: "all" or a positive integer.
recursive_quorum = 1
# First re-check interval while waiting for propagation, in seconds.
initial_interval_secs = 5
# Upper bound of the exponential back-off between re-checks, in seconds.
max_interval_secs = 60

[challenge.tls_alpn]
listen_addr = "127.0.0.1:5001"

[renewal]
check_interval = 3600
renew_before_days = 30
max_retries = 3
retry_delay_secs = 300
concurrency = 5

[metrics]
enabled = true
listen_addr = "127.0.0.1:9090"
prefix = "acmex"

[cli]
output_format = "text"
colors = true
log_level = "info"
log_max_size = 100
log_backup_count = 10

[server]
listen_addr = "127.0.0.1:8080"
enable_api = true
enable_webhook = true
